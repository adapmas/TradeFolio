{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "trade",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "instruments": {
        "ClusterId": "trade",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/api/v1/instruments/{**catch-all}" }
      },
      "users": {
        "ClusterId": "trade",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "trades": {
        "ClusterId": "trade",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/v1/trades/{**catch-all}" }
      },
      "holdings": {
        "ClusterId": "trade",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/api/v1/holdings/{**catch-all}" }
      }
    },
    "Clusters": {
      "trade": {
        "Destinations": {
          "tradeservice": { "Address": "http://localhost:5100/" }
        }
      }
    }
  }
}